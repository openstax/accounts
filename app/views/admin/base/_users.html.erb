<%# Renderer's of this partial can direct the form's target with 'override_search_path' %>

<h4>Users</h4>

<%= lev_form_for :search,
                 url: (override_search_path ||= js_search_admin_users_path),
                 remote: true,
                 method: :get,
                 html: {class: 'form-inline'} do |f| %>

  Search for
  <%= f.search_field :terms,
                      style: 'width:400px;',
                      class: 'form-control',
                      placeholder: 'id:42, email:jane@example.com, or name:garcia' %>

  Ordered by
  <%= f.search_field :order_by, style: 'width:150px;', class: 'form-control' %>

  <%= f.hidden_field :per_page, value: 50 %>

  <%= f.submit 'Search', class: 'btn btn-primary' %>

<% end %>

<div id="search-results-list"></div>
