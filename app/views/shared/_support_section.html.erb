<div class="account-support__cards openstax-support">
  <a href="https://help.openstax.org/" class="account-support__card" target="_blank" rel="noopener">
    <span class="account-support__icon fa fa-headphones" aria-hidden="true"></span>
    <h2>Visit the help center</h2>
    <p>Browse FAQs, start a chat, or open a ticket with the OpenStax support team.</p>
    <span class="account-support__action">Go to help center <span class="arrow" aria-hidden="true">→</span></span>
  </a>
  <a href="mailto:support@openstax.org" class="account-support__card">
    <span class="account-support__icon fa fa-paper-plane" aria-hidden="true"></span>
    <h2>Email support</h2>
    <p>Need something specific? Reach us directly at support@openstax.org.</p>
    <span class="account-support__action">Send us an email <span class="arrow" aria-hidden="true">→</span></span>
  </a>
</div>
<ul class="account-support__more">
  <li>
    <a href="https://status.openstax.org" target="_blank" rel="noopener"><%= t('support_links.status') %> <span class="arrow" aria-hidden="true">→</span></a>
  </li>
  <li>
    <a href="https://openstax.org/newsletters" target="_blank" rel="noopener"><%= t('support_links.news') %> <span class="arrow" aria-hidden="true">→</span></a>
  </li>
</ul>
