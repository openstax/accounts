<% show_user = true if show_user.nil? %>

<table id="security-log-table" class="table table-striped">
  <thead>
    <tr>
      <th>Time (CT)</th>
      <% if show_user %>
      <th>User</th>
      <% end %>
      <th>App</th>
      <th>IP</th>
      <th>Type</th>
      <th>Data</th>
    </tr>
  </thead>

  <tbody>
    <% security_log.each do |log_entry| %>
    <%= render partial: "shared/security_log_entry", locals: { security_log_entry: log_entry,
                                                               show_user: show_user } %>
    <% end %>
  </tbody>
</table>

<% content_for :javascript do %>
  <script type="text/javascript">
    $('#security-log-table .expand').click(function(e) {
      e.preventDefault();
      $(this).closest('tr').next('tr.details').toggle();
      $(this).find('i').toggleClass('fa-plus fa-minus');
    });
  </script>
<% end %>
