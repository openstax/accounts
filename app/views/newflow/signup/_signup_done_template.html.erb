<div id="login-signup-form">
    <div class="content">
        <%= render partial: 'newflow/tab_group' , locals: { active_class: 'signup--active' } %>

        <%= newflow_login_signup_card(
                    id: 'signup-page',
                    classes: "signup-page",
                    header: header,
                    show_exit_icon: true) do %>
            <form action="<%= exit_accounts_path %>">
                <div class="content control-group info-message">
                    <%= description %>
                    <br />
                    <br />

                    <%= image %>

                    <%=
                        button_tag(
                            t(:"login_signup_form.finish"),
                            data: {
                                'ga-category': 'Account Creation',
                                'ga-action': 'Click',
                                'ga-label': '5-Finish'
                            }
                        )
                    %>
                </div>
            </form>

            <%# After the message, not before it: this page's body is the
                explanation of what the user is waiting for, and offering a way
                out reads as noise until they have read it. The body form's
                bottom border becomes the divider, and the block closes the
                card -- see the `:last-child` rule. %>
            <% if local_assigns[:alternatives].present? %>
                <%= render partial: 'newflow/signup_alternatives', locals: {
                      collapsible: true,
                      heading: alternatives[:heading],
                      actions: alternatives[:actions]
                    } %>
            <% end %>
        <% end  %>
    </div>
</div>
