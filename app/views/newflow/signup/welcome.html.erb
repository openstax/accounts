<div id="login-signup-form">
    <div class="content">
        <%= render partial: 'newflow/tab_group', locals: { active_class: 'signup--active' } %>

        <%= newflow_login_signup_card(
                    id: 'signup-page',
                    classes: "welcome-page",
                    header: (I18n.t(:"login_signup_form.welcome_page_header")),
                    banners: @banners,
                    show_exit_icon: true) do %>
            <% lev_form_for :login, url: '' do |form| %>
                <%
                    fh = NewflowFormHelper::Newflow.new(
                        f: form,
                        context: self,
                        errors: @handler_result&.errors
                    )
                    @page_title = 'Sign up'
                %>

                <div class="content">
                    <p class="join-as__subheader"><%= I18n.t(:"login_signup_form.welcome_page_subheader") %></p>

                    <div class="join-as join-as--rows">
                        <%= link_to educator_signup_path, class: 'join-as__option join-as__option--educator educator', data: { 'ga-category': 'Account Creation', 'ga-action': 'Click', 'ga-label': '2B-Educator' } do %>
                            <span class="join-as__option-icon" aria-hidden="true"><%= image_tag('educator-icon.svg', alt: '') %></span>
                            <span class="join-as__option-text">
                                <span class="join-as__option-title"><%= I18n.t(:"login_signup_form.join_as_educator_title") %></span>
                                <span class="join-as__option-desc"><%= I18n.t(:"login_signup_form.join_as_educator_description") %></span>
                            </span>
                            <span class="join-as__option-arrow" aria-hidden="true">&rarr;</span>
                        <% end %>

                        <%= link_to (get_alternate_signup_url || newflow_signup_student_path), class: 'join-as__option join-as__option--student student', data: { 'ga-category': 'Account Creation', 'ga-action': 'Click', 'ga-label': '2A-Student' } do %>
                            <span class="join-as__option-icon" aria-hidden="true"><%= image_tag('student-icon.svg', alt: '') %></span>
                            <span class="join-as__option-text">
                                <span class="join-as__option-title"><%= I18n.t(:"login_signup_form.join_as_student_title") %></span>
                                <span class="join-as__option-desc"><%= I18n.t(:"login_signup_form.join_as_student_description") %></span>
                            </span>
                            <span class="join-as__option-arrow" aria-hidden="true">&rarr;</span>
                        <% end %>
                    </div>

                    <p class="join-as__learner-hint">
                        <%= I18n.t(:"login_signup_form.learner_escape_hatch",
                                   skip_the_questions: link_to(I18n.t(:"login_signup_form.learner_skip_the_questions"), newflow_signup_learner_path)).html_safe %>
                    </p>

                    <p class="join-as__login-hint">
                        <%= I18n.t(:"login_signup_form.already_have_account",
                                   log_in: link_to(I18n.t(:"login_signup_form.log_in"), newflow_login_path)).html_safe %>
                    </p>
                </div>

            <% end %>
        <% end %>
    </div>
</div>
