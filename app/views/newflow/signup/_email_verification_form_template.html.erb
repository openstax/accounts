<%= render 'newflow/educator_signup/refresh_upon_going_back' %>

<div id="login-signup-form">
    <div class="content">
        <%= render partial: 'newflow/tab_group', locals: { active_class: 'signup--active'} %>

        <%= newflow_login_signup_card(
                    id: 'signup-page',
                    classes: "signup-page",
                    header: header,
                    current_step: current_step) do %>
            <%= lev_form_for :confirm, url: submit_to_path do |form| %>
                <%
                    form_helper = NewflowFormHelper::Newflow.new(
                        f: form,
                        context: self,
                        errors: @handler_result&.errors
                    )
                    @page_title = 'Sign up (confirm email)'
                %>

                <div class="content info-message">
                    <%= form_description %>
                </div>

                <div class="content control-group">
                    <%= label_tag :pin, I18n.t(:"login_signup_form.pin_label"),
                                class: 'field-label required'
                    %>
                    <%= form_helper.text_field name: :pin,
                                placeholder: I18n.t(:"login_signup_form.pin_placeholder"),
                                autofocus: true,
                                required: true
                    %>
                </div>

                <div class="content">
                    <%= help_message %>
                </div>

                <br />

                <div class="content">
                    <%=
                        form.submit(
                            I18n.t(:"login_signup_form.confirm_my_account_button"),
                            class: 'primary',
                            data: {
                                disable_with: false,
                                'ga-category': 'Account Creation',
                                'ga-action': 'Click',
                                'ga-label': '4A-Confirm My Account'
                            }
                        )
                    %>
                </div>

            <% end %>

            <%# Outside the PIN form: a button_to nested in it would be dropped.
                A missing email is the most common way people get stuck here, so
                this stays visible rather than collapsed. %>
            <%= render partial: 'newflow/signup_alternatives', locals: {
                  heading: I18n.t(:"login_signup_form.didnt_get_the_email"),
                  actions: [
                    {
                      label: I18n.t(:"login_signup_form.resend_signup_email"),
                      description: I18n.t(:"login_signup_form.resend_signup_email_description"),
                      path: resend_path,
                      method: :post,
                      ga_label: 'resend-signup-email'
                    },
                    {
                      label: I18n.t(:"login_signup_form.use_a_different_email"),
                      description: I18n.t(:"login_signup_form.use_a_different_email_description"),
                      path: change_email_path,
                      method: :get,
                      ga_label: 'change-signup-email'
                    }
                  ]
                } %>
        <% end %>
    </div>
</div>
