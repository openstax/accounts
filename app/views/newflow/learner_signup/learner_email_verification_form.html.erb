<%
    current_step = I18n.t(
        :"login_signup_form.step_counter",
        current_step: 2,
        total_steps: 2
    )

    form_description = I18n.t(
        :"login_signup_form.learner_email_verification_form_decription",
        email: @email,
        edit_your_email: link_to(
            I18n.t(:"login_signup_form.edit_your_email"), learner_change_signup_email_form_path
        )
    ).html_safe

    help_message = I18n.t(
        :"login_signup_form.didnt_receive_email",
        sign_up_with_different_email_link: link_to(
            I18n.t(:"login_signup_form.sign_up_with_different_email"), learner_change_signup_email_form_path
        )
    ).html_safe
%>

<%=
  render(
    partial: 'newflow/signup/email_verification_form_template',
    locals: {
        header: I18n.t(:"login_signup_form.confirm_your_info"),
        form_description: form_description,
        current_step: current_step,
        help_message: help_message,
        submit_to_path: learner_verify_pin_path
    }
  )
%>
