<%= render 'newflow/educator_signup/refresh_upon_going_back' %>

<div id="login-signup-form">
  <div class="content">
    <%
      # Order matches the compressed step-4 design: Instructor first (default
      # selection), then Administrator/Researcher, with "Other staff" last
      # since it routes away from the rest of this form. Defaults to
      # "instructor" only when the user hasn't already picked a role (e.g. a
      # first-time visit) -- a returning user finishing their profile later
      # (see account Overview's "Finish your profile" nudge) sees their own
      # previously-saved role selected instead.
      current_educator_role = %w(instructor administrator researcher other).include?(user.role) ? user.role : 'instructor'
      educator_complete_roles = [
        [ educator_copy(:instructor), 'instructor', current_educator_role == 'instructor' ],
        [ educator_copy(:administrator), 'administrator', current_educator_role == 'administrator' ],
        [ educator_copy(:researcher), 'researcher', current_educator_role == 'researcher' ],
        [ educator_copy(:other), 'other', current_educator_role == 'other' ]
      ]
    %>

    <% @page_title = 'Sign up (complete profile)' %>
    <%= render partial: 'newflow/tab_group', locals: { active_class: 'signup--active'} %>

    <%= newflow_login_signup_card(
          id: 'signup-page',
          header: educator_copy(:complete_page_header),
          current_step: I18n.t(:"login_signup_form.step_counter", current_step: 4, total_steps: 4),
          progress_bar: 1.0,
          classes: 'signup-page completed-step') do %>
    <%= lev_form_for :signup, url: educator_complete_profile_path do |f| %>
    <%
      fh = NewflowFormHelper::Newflow.new(
        f: f,
        context: self,
        errors: @handler_result&.errors
      )
    %>
    <%#
      Historical note: content placement here used to be load-bearing -- with
      the old non-output lev_form_for tag, any sibling printed content in the
      card's capture scope silently dropped the whole form (Rails `capture`
      only falls back to the block's return value when the output buffer is
      empty). Now that lev_form_for is invoked as an output tag (see
      CLAUDE.md, "View gotcha"), placement is free. NB: never put literal
      ERB delimiters inside this comment -- a percent-gt sequence ends it.
    %>
    <p class="profile-subtitle"><%= educator_copy(:profile_subtitle) %></p>

    <%#
      Static mission stat rather than a per-book adoption count: the design
      mock showed a per-book figure ("3,200 instructors used Biology 2e"), but
      that data isn't trivially available server-side here, and we never want
      to show a fabricated number. Swap in a verified, sourced figure (e.g.
      from openstax-data) if/when one is wired up.
    %>
    <div class="profile-social-proof">
      <%= educator_copy(:social_proof).html_safe %>
    </div>
        <div class="content required-fields-notice">
          <%= I18n.t(:"login_signup_form.all_fields_required") %>
        </div>

        <div class="content">
          <div class="questions">

            <div class="form-group question school-name<%= should_show_school_name_field? ? ' school-name-visible' : '' %>">
              <div class="school-name">
                <%=
                  label_tag(
                    :school_name,
                    educator_copy(:school_name),
                    class: 'field-label'
                  )
                %>
                <div class="school-name newflow-mustdo-alert">
                  <%= educator_copy(:school_name_must_be_entered) %>
                </div>
                <div class="school-autocomplete" data-use-as-entered-label="<%= I18n.t(:"school_autocomplete.use_as_entered_label") %>">
                  <%=
                    fh.text_field(
                      name: :school_name,
                      placeholder: educator_copy(:school_name),
                      autofocus: true
                    )
                  %>
                  <%= f.hidden_field :school_id %>
                </div>
                <div class="school-match-confirmation" style="display: none;"></div>
              </div>
            </div>

            <div class="form-group question school-issued-email<%= should_show_school_issued_email_field? ? ' school-issued-email-visible' : '' %>">
              <div class="school-issued-email">
                <%=
                  label_tag(
                    :school_issued_email,
                    educator_copy(:school_issued_email),
                    class: 'field-label'
                  )
                %>
                <%=
                  fh.text_field(
                    name: :school_issued_email,
                    placeholder: educator_copy(:school_issued_email),
                    value: user.email_addresses.last&.value
                  )
                %>
              </div>
            </div>

            <fieldset class="question grade-band">
              <legend class='field-label'><%= educator_copy(:grade_levels) %></legend>
              <div class="radio-control-group">
                <label>
                  <%= f.radio_button(:grade_band, 'elementary', checked: false, class: 'custom-control-input') %>
                  <%= label :grade_band_elementary, educator_copy(:grade_band_elementary), class: 'custom-control-label' %>
                </label>
                <label>
                  <%= f.radio_button(:grade_band, 'middle', checked: false, class: 'custom-control-input') %>
                  <%= label :grade_band_middle, educator_copy(:grade_band_middle), class: 'custom-control-label' %>
                </label>
                <label>
                  <%= f.radio_button(:grade_band, 'high', checked: false, class: 'custom-control-input') %>
                  <%= label :grade_band_high, educator_copy(:grade_band_high), class: 'custom-control-label' %>
                </label>
                <label>
                  <%= f.radio_button(:grade_band, 'multiple', checked: false, class: 'custom-control-input') %>
                  <%= label :grade_band_multiple, educator_copy(:grade_band_multiple), class: 'custom-control-label' %>
                </label>
              </div>
            </fieldset>

            <fieldset class="question completed-role">
              <legend class='field-label'><%= educator_copy(:describe_role) %></legend>
              <div class="radio-control-group">
                <div class="role newflow-mustdo-alert">
                  <%= educator_copy(:select_option) %>
                </div>

                <% educator_complete_roles.each do |(role, id, selected)| %>
                  <label>
                    <% label_name = "educator_specific_role_#{id}".to_sym %>
                    <%=
                      f.radio_button(
                        :educator_specific_role,
                        id,
                        checked: selected,
                        class: 'completed-role custom-control-input'
                      )
                    %>
                    <%= label(label_name, role, class: 'custom-control-label') %>
                  </label>
                <% end %>

              </div>

              <%#
                Choosing "Other staff" routes to the staff questionnaire
                ("Tell us about your work") via the data attribute below --
                see onRoleChange in educator_complete_dynamic.js.coffee. The
                inline "please specify" field stays as a no-JS fallback.
              %>
              <div class="other-specify" data-staff-details-path="<%= staff_details_form_path %>">
                <%= label_tag :other_role_name, educator_copy(:other_please_specify),
                              class: 'field-label'
                %>
                <div class="other newflow-mustdo-alert">
                  <%= educator_copy(:fill_out) %>
                </div>
                <%=
                  fh.text_field(
                    name: :other_role_name,
                    placeholder: educator_copy(:other_please_specify),
                    autofocus: true
                  )
                %>
              </div>
              <div class="form-helper-text"><%= educator_copy(:other_staff_routing_note) %></div>
            </fieldset>

            <fieldset class="question how-using">
              <legend class='field-label'><%= educator_copy(:how_using) %></legend>
              <div class="radio-control-group">
                <div class="using newflow-mustdo-alert">
                  <%= educator_copy(:select_option) %>
                </div>
                <label class="usage-option">
                  <%=
                    f.radio_button(
                      :using_openstax_how,
                      :as_primary,
                      checked: false,
                      class: 'completed-role custom-control-input'
                    )
                  %>
                  <%= label :using_primary_textbook, educator_copy(:using_primary_textbook), class: 'custom-control-label' %>
                </label>
                <label class="usage-option">
                  <%=
                    f.radio_button(
                      :using_openstax_how,
                      :as_recommending,
                      checked: false,
                      class: 'completed-role custom-control-input'
                    )
                  %>
                  <%= label :using_recommending_openstax, educator_copy(:using_recommending_openstax), class: 'custom-control-label' %>
                </label>
                <label class="usage-option">
                  <%=
                    f.radio_button(
                      :using_openstax_how,
                      :as_future,
                      checked: false,
                      class: 'completed-role custom-control-input'
                    )
                  %>
                  <%= label :using_future, educator_copy(:using_future), class: 'custom-control-label' %>
                </label>
              </div>
            </fieldset>

            <% if Settings::FeatureFlags.expected_start_semester_enabled %>
              <fieldset class="form-group question expected-start-semester" style="display: none;">
                <legend class='field-label'>
                  <%= I18n.t(:"educator_profile_form.expected_start_semester") %>
                </legend>
                <%=
                  fh.select(
                    name: :expected_start_semester,
                    options: options_for_select(
                      [['', '']] +
                      I18n.t(:"educator_profile_form.expected_start_semester_options").map { |key, display| [display, key.to_s] }
                    )
                  )
                %>
              </fieldset>
            <% end %>

            <div class="form-group question books-used">
              <%=
                label_tag(
                  :books_used,
                  educator_copy(:books_used),
                  class: 'field-label'
                )
              %>
              <div class="used newflow-mustdo-alert">
                <%= educator_copy(:select_option) %>
              </div>
              <div class="used-limit newflow-mustdo-alert">
                <%= educator_copy(:select_option_limit_5) %>
              </div>

              <%= render partial: 'newflow/educator_signup/book_picker',
                         locals: { field_name: 'books_used', books_by_subject: @books_by_subject } %>
              <div class="form-helper-text"><%= educator_copy(:book_picker_select_up_to) %></div>
            </div>

            <div data-template-id="used-book-info" class="book-detail-card">
              <div class="book-detail-header">
                <img src="" data-placeholder-id="used-book-cover" class="book-detail-cover" alt="">
                <span data-placeholder-id="used-book-name" class="book-detail-title"></span>
              </div>
              <div class="book-detail-body">
                <p class="book-detail-helper"><%= educator_copy(:include_ta_sections) %></p>
                <div class="book-detail-fields">
                  <div class="book-detail-field students-using-book">
                    <%= label_tag nil, educator_copy(:students_per_semester), class: 'field-label' %>
                    <div class="num-using-book newflow-mustdo-alert" style="display: none">
                      <%= educator_copy(:fill_out) %>
                    </div>
                    <%=
                      fh.text_field(
                        name: 'books_used_details[%placeholder-book-name%]num_students_using_book',
                        placeholder: educator_copy(:num_students_using_book_placeholder),
                        autofocus: false,
                        numberonly: true,
                        disabled: true
                      )
                    %>
                  </div>
                  <div class="book-detail-field how-using-book">
                    <%= label_tag nil, educator_copy(:how_using_this_book), class: 'field-label' %>
                    <div class="using-book newflow-mustdo-alert" style="display: none">
                      <%= educator_copy(:fill_out) %>
                    </div>
                    <%= fh.select name: 'books_used_details[%placeholder-book-name%]how_using_book',
                        options: options_for_select([['', '']] + educator_copy(:how_using_book_options)),
                        autofocus: false,
                        disabled: true
                    %>
                  </div>
                </div>
              </div>
            </div>

            <div class="form-group question books-of-interest">
              <%=
                label_tag(
                  :books_of_interest,
                  educator_copy(:books_of_interest),
                  class: 'field-label'
                )
              %>
              <div class="books-of-interest newflow-mustdo-alert">
                <%= educator_copy(:select_option) %>
              </div>
              <div class="books-of-interest-limit newflow-mustdo-alert">
                <%= educator_copy(:select_option_limit_5) %>
              </div>

              <%= render partial: 'newflow/educator_signup/book_picker',
                         locals: { field_name: 'books_of_interest', books_by_subject: @books_by_subject } %>
              <div class="form-helper-text"><%= educator_copy(:book_picker_select_up_to) %></div>
            </div>

            <% if Settings::FeatureFlags.collect_student_count_all_paths %>
              <div class="form-group question total-num-students"
                   data-label-default="<%= I18n.t(:'educator_profile_form.num_students_future_recommending') %>"
                   data-label-admin="<%= I18n.t(:'educator_profile_form.num_students_administrator') %>"
                   data-label-other="<%= I18n.t(:'educator_profile_form.num_students_other') %>">
                <%= label_tag(
                      :total_num_students,
                      I18n.t(:"educator_profile_form.num_students_future_recommending"),
                      class: 'field-label',
                      id: 'total-num-students-label'
                    )
                %>
                <div class="total-num-students-alert newflow-mustdo-alert">
                  <%= I18n.t(:"educator_profile_form.fill_out") %>
                </div>
                <%=
                  fh.text_field(
                    name: :total_num_students,
                    placeholder: I18n.t(:"educator_profile_form.num_students_total_placeholder"),
                    autofocus: false,
                    numberonly: true
                  )
                %>
                <div class="form-helper-text">A ballpark for this school year is fine.</div>
              </div>
            <% end %>

          </div>

          <%= f.hidden_field :is_school_not_supported_by_sheerid, value: is_school_not_supported_by_sheerid? %>
          <%= f.hidden_field :is_country_not_supported_by_sheerid, value: is_country_not_supported_by_sheerid? %>
          <%= f.hidden_field :is_cs_form, value: is_cs_form? %>
          <%= f.hidden_field :finish_later, value: 'false' %>

          <%=
            f.submit(
              educator_copy(:finish_button),
              id: 'signup_form_submit_button',
              class: 'primary',
              data: {
                disable_with: educator_copy(:finish_button),
                #  Google Analytics
                ga_category: 'Account Creation',
                ga_action: 'Click',
                ga_label: '3A-Email'
              }
            )
          %>
          <button type="button" class="finish-later-link" id="finish-later-button">
            <%= educator_copy(:finish_later_link) %>
          </button>
        </div>
      <% end %>
    <% end %>
  </div>
</div>

<script type="text/javascript">

  //this needs to be done at bottom of the file so that the dom above is already constructed
  new NewflowUi.EducatorComplete();
  OxSchoolAutocomplete.attach('.school-autocomplete');
</script>
