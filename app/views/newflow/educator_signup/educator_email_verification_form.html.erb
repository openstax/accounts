<%
    page_header = I18n.t(
        :"login_signup_form.confirmation_page_header",
        first_name: @first_name
    )

    current_step = I18n.t(
        :"login_signup_form.step_counter",
        current_step: 2,
        total_steps: @total_steps
    )

    form_description = I18n.t(
        :"login_signup_form.educator_email_verification_form_decription",
        email: @email
    ).html_safe

    help_message = I18n.t(
        :"login_signup_form.havent_received_message",
        contact_us: contact_us_link
    ).html_safe
%>

<%=
    render(
        partial: 'newflow/signup/email_verification_form_template',
        locals: {
            header: page_header,
            current_step: current_step,
            form_description: form_description,
            help_message: help_message,
            submit_to_path: educator_verify_pin_path,
            resend_path: educator_resend_signup_email_path,
            change_email_path: educator_change_signup_email_form_path
        }
    )
%>
