<%= render 'newflow/educator_signup/refresh_upon_going_back' %>
<% @page_title = 'Sign up (verify instructor)' %>

<div id="login-signup-form">
  <div class="content educator-sheerid-form-page">
    <%= render partial: 'newflow/tab_group', locals: { active_class: 'signup--active'} %>

    <%= newflow_login_signup_card(
          id: 'signup-page',
          current_step: I18n.t(:"login_signup_form.step_counter", current_step: 3, total_steps: 4),
          classes: 'signup-page') do %>

        <%= render partial: 'newflow/signup_alternatives', locals: {
              collapsible: true,
              heading: I18n.t(:"login_signup_form.alternatives_heading"),
              actions: [
                {
                  label: I18n.t(:"login_signup_form.alternative_manual_verification"),
                  description: I18n.t(:"login_signup_form.alternative_manual_verification_description"),
                  path: educator_profile_form_path(school: 'unknown'),
                  method: :get,
                  ga_label: 'skip-instant-verification'
                },
                {
                  label: I18n.t(:"login_signup_form.switch_role_student"),
                  description: I18n.t(:"login_signup_form.switch_role_student_description"),
                  path: switch_signup_role_path,
                  method: :post,
                  ga_label: 'switch-to-student'
                }
              ]
            } %>

        <form>
          <div class="content control-group">
            <iframe
              id="sheerid-iframe"
              title='instructor verification'
              src="<%= @sheerid_url %>"
              data-sheerid-uid="<%= @sheerid_iframe_uid %>"
              data-sheerid-origin="<%= @sheerid_origin %>"
              data-sheerid-first-name="<%= current_user.first_name %>"
              data-sheerid-last-name="<%= current_user.last_name %>"
              data-sheerid-email="<%= current_user.email_addresses.first&.value %>"
              <%# SheerID's own installer delegates camera, microphone,
                  geolocation and clipboard. Document upload needs the camera,
                  and without this the frame is silently denied it. Microphone
                  and geolocation are left off: nothing in educator
                  verification asks for them, and this origin handles
                  passwords. Add them if a later step turns out to need them. %>
              allow="camera *; clipboard-read *; clipboard-write *"
              frameborder=0
              width="100%">
            </iframe>
          </div>
        </form>
    <% end %>
  </div>
</div>

<%= javascript_include_tag 'newflow/sheerid_iframe' %>
