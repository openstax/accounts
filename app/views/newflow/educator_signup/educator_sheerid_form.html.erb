<%= render 'newflow/educator_signup/refresh_upon_going_back' %>
<% @page_title = 'Sign up (verify instructor)' %>

<div id="login-signup-form">
  <div class="content educator-sheerid-form-page">
    <%= render partial: 'newflow/tab_group', locals: { active_class: 'signup--active'} %>

    <%= newflow_login_signup_card(
          id: 'signup-page',
          header: I18n.t(:"login_signup_form.sheerid_verification_page_header"),
          current_step: "#{I18n.t(:"login_signup_form.step_counter", current_step: 3, total_steps: 4)} · #{I18n.t(:"login_signup_form.sheerid_verification_step_phase")}",
          classes: 'signup-page') do %>

        <p class="content control-group sheerid-verification-description">
          <%= I18n.t(:"login_signup_form.sheerid_verification_page_description") %>
        </p>

        <% if @show_school_email_gate %>
          <div class="content control-group banner orange school-email-gate">
            <div class="school-email-gate__title">
              <%= I18n.t(:"login_signup_form.school_email_gate_title") %>
            </div>
            <p class="school-email-gate__description">
              <%=
                I18n.t(
                  :"login_signup_form.school_email_gate_description_html",
                  current_email: @on_file_email
                ).html_safe
              %>
            </p>

            <%= lev_form_for :school_email, url: educator_add_school_email_path do |f| %>
              <% fh = NewflowFormHelper::Newflow.new(f: f, context: self, errors: @handler_result&.errors) %>

              <%=
                label_tag(
                  :school_email_email,
                  I18n.t(:"login_signup_form.school_issued_email_label"),
                  class: 'field-label required'
                )
              %>
              <%=
                fh.text_field(
                  name: :email,
                  placeholder: I18n.t(:"login_signup_form.school_issued_email_placeholder"),
                  required: true
                )
              %>
              <div class="school-email-gate__note">
                <%= I18n.t(:"login_signup_form.school_email_gate_note") %>
              </div>

              <div class="content">
                <%= f.submit(I18n.t(:"login_signup_form.continue_button"), class: 'primary') %>
              </div>
            <% end %>

            <%=
              link_to(
                I18n.t(:"login_signup_form.use_current_email_anyway"),
                educator_sheerid_form_path(use_current_email: true),
                class: 'school-email-gate__use-current-link'
              )
            %>
          </div>
        <% end %>

        <%= render partial: 'newflow/signup_alternatives', locals: {
              collapsible: true,
              heading: I18n.t(:"login_signup_form.alternatives_heading"),
              actions: [
                {
                  label: I18n.t(:"login_signup_form.alternative_manual_verification"),
                  description: I18n.t(:"login_signup_form.alternative_manual_verification_description"),
                  path: educator_profile_form_path(school: 'unknown'),
                  method: :get,
                  ga_label: 'skip-instant-verification'
                },
                {
                  label: I18n.t(:"login_signup_form.switch_role_student"),
                  description: I18n.t(:"login_signup_form.switch_role_student_description"),
                  path: switch_signup_role_path,
                  method: :post,
                  ga_label: 'switch-to-student'
                }
              ]
            } %>

        <form>
          <div class="content control-group">
            <iframe
              title='instructor verification'
              src="<%= @sheerid_url %>"
              frameborder=0
              width="100%">
            </iframe>
          </div>
        </form>
    <% end %>
  </div>
</div>
