<%
  header = I18n.t(:"login_signup_form.educator_pending_cs_verification")
  description = I18n.t(
    :"login_signup_form.educator_pending_cs_verification_description",
    email_address: current_user.email_addresses.last&.value
  ).html_safe
%>

<%=
  render(
    'newflow/signup/signup_done_template',
    header: header,
    description: description,
    image: nil,
    alternatives: {
      heading: I18n.t(:"login_signup_form.alternatives_heading"),
      actions: [
        {
          label: I18n.t(:"login_signup_form.switch_role_student"),
          description: I18n.t(:"login_signup_form.switch_role_student_description"),
          path: switch_signup_role_path,
          method: :post,
          ga_label: 'switch-to-student'
        }
      ]
    }
  )
%>
