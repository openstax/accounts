<div class="page-header">
  <h1><%= t('.title', name: @application.name, role: @role) %></h1>
</div>

<% if @users.present? %>
  <ul>
    <% @users.each do |user| %>
      <li>
        <% if @user.is_administrator? %>
          <%= link_to user.name, edit_admin_user_path(user) %>
        <% else %>
          <%= user.name %>
        <% end %>
      </li>
    <% end %>
  </ul>
<% else %>
  <p><%= t('.no_users') %></p>
<% end %>
