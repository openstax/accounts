<div class="account-callout" id="profile-nudge-callout">
  <div class="account-callout__text">
    <p class="account-callout__eyebrow">Finish signing up</p>
    <h2 class="account-callout__title"><%= t(:"profile_nudge_banner.heading") %></h2>
    <p><%= t(:"profile_nudge_banner.body") %></p>
  </div>
  <div class="account-callout__actions">
    <%=
      link_to(
        t(:"profile_nudge_banner.finish_button"),
        educator_profile_form_path,
        class: 'account-callout__button account-callout__button--primary js-profile-nudge-finish',
        data: {
          'ga-category': 'Profile Nudge',
          'ga-action': 'Click',
          'ga-label': 'Finish setting up'
        }
      )
    %>
    <%=
      button_to(
        t(:"profile_nudge_banner.dismiss_button"),
        dismiss_profile_nudge_path,
        method: :post,
        class: 'account-callout__button account-callout__button--ghost',
        form_class: 'account-callout__button-form',
        data: {
          'ga-category': 'Profile Nudge',
          'ga-action': 'Click',
          'ga-label': 'Dismiss'
        }
      )
    %>
  </div>
</div>
