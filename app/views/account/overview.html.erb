<% content_for :head do %>
  <%= javascript_include_tag 'newflow/profile_nudge_banner' if @show_profile_nudge_banner %>
<% end %>

<% school_supports_assignable = current_user.school&.has_assignable_contacts? %>
<% assignable_enabled = current_user.external_ids.exists? %>
<% dismissed_assignable_callout = cookies[:dismissed_assignable_callout] == 'true' %>
<% allow_callout_persistence = !current_user.is_administrator? %>
<% is_verified_instructor = current_user.confirmed_faculty? %>
<% staff = current_user.completed_non_teaching_profile? %>
<% pending_instructor = !staff && !is_verified_instructor && !current_user.incomplete_signup? && !current_user.rejected_faculty? %>
<% incomplete_signup = !staff && current_user.incomplete_signup? %>
<% show_assignable_callout = school_supports_assignable && is_verified_instructor && !assignable_enabled && (!dismissed_assignable_callout || current_user.is_administrator?) %>

<% school_name = current_user&.school&.name.presence || current_user&.self_reported_school.presence %>
<% faculty_status = current_user&.faculty_status.to_s %>
<% instructor_status =
    case faculty_status
    when 'confirmed_faculty' then 'Verified'
    when 'pending_faculty', 'pending_sheerid' then 'Pending verification'
    when 'rejected_faculty', 'rejected_by_sheerid' then 'Not verified'
    when 'incomplete_signup' then 'Incomplete signup'
    when 'no_faculty_info', '' then 'Not verified'
    else faculty_status.titleize
    end %>
<% role_label = staff ? current_user.staff_role_label : (current_user.role.present? ? current_user.role.titleize : 'Instructor') %>
<% account_health =
     if pending_instructor
       'Verification needed'
     elsif incomplete_signup
       'Finish signup'
     else
       'All set'
     end %>
<% completeness = account_completeness_summary(current_user) %>

<div class="account-layout">
  <%= render 'account/navigation' %>
  <div class="account-layout__content">
    <header class="account-overview__header">
      <h1 class="account-overview__title">
        Welcome back<% if current_user&.first_name.present? %>, <%= current_user.first_name %><% end %>
      </h1>

      <div class="account-overview__badges">
        <% if is_verified_instructor %>
          <span class="account-badge account-badge--verified">Verified educator</span>
        <% end %>
        <% if current_user.school&.name.present? %>
          <span class="account-badge account-badge--school"><%= current_user.school.name %></span>
        <% end %>
      </div>

      <p class="account-overview__subtitle">
        <% if school_name.present? && staff %>
          Your account is linked to <strong><%= school_name %></strong>. Access your resources and account settings from here.
        <% elsif school_name.present? %>
          You’re signed in as an instructor at <strong><%= school_name %></strong>. Access your teaching tools, resources, and account settings from here.
        <% else %>
          Access your teaching tools, resources, and account settings from here. Add your school to personalize your experience.
          <a class="account-overview__inline-link" href="<%= account_profile_path %>">Update profile</a>
        <% end %>
      </p>
    </header>

    <%= render 'account/check_in_card', check_in: @annual_check_in if @annual_check_in %>

    <%= render 'account/overview_impact_card', impact: @overview_impact if @overview_impact %>

    <% if show_assignable_callout %>
      <div class="account-callout account-callout--assignable" id="assignable-callout">
        <div class="account-callout__text">
          <p class="account-callout__eyebrow">OpenStax Assignable</p>
          <h2 class="account-callout__title">Assignable is available at <%= current_user.school&.name || 'your institution' %></h2>
          <p>
            Good news — <%= current_user.school&.name || 'your institution' %> supports OpenStax Assignable.
            Use Assignable to give your students auto-graded practice and keep grades synced, all within your learning management system (LMS).
          </p>
          <p>You can choose whether and when to use it — support is available if you’d like help getting started.</p>
        </div>
        <div class="account-callout__actions">
          <%= link_to 'Set up Assignable', 'https://openstax.org/assignable/setup', class: 'account-callout__button account-callout__button--primary', target: '_blank', rel: 'noopener' %>
          <%= link_to 'Learn more', 'https://openstax.org/assignable', class: 'account-callout__button account-callout__button--ghost', target: '_blank', rel: 'noopener' %>
        </div>
        <button type="button"
                class="account-callout__dismiss js-dismiss-callout"
                aria-label="Dismiss Assignable message"
                data-dismiss-target="assignable-callout"
                data-persist-dismissal="<%= allow_callout_persistence %>">
          &times;
        </button>
      </div>
    <% end %>

    <% if @show_profile_nudge_banner %>
      <%= render 'account/profile_nudge_callout' %>
    <% elsif pending_instructor %>
      <div class="account-callout" id="verification-callout">
        <div class="account-callout__text">
          <p class="account-callout__eyebrow">Action required</p>
          <h2 class="account-callout__title">Complete instructor verification</h2>
          <p>Verifying your instructor status unlocks instructor-only resources, downloadable assets, and Assignable tools.</p>
          <p>Finish verification today to keep your educator access active.</p>
        </div>
        <div class="account-callout__actions">
          <%= link_to 'Verify now',
                      'https://help.openstax.org/s/article/Requesting-Instructor-only-access-to-the-resources-on-openstax-org',
                      class: 'account-callout__button account-callout__button--primary',
                      target: '_blank',
                      rel: 'noopener' %>
        </div>
      </div>
    <% elsif incomplete_signup %>
      <div class="account-callout" id="complete-signup-callout">
        <div class="account-callout__text">
          <p class="account-callout__eyebrow">Finish signing up</p>
          <h2 class="account-callout__title">Complete your instructor profile</h2>
          <p>We still need a bit more information to activate your instructor access.</p>
          <p>Finish the signup flow to verify your teaching role and unlock instructor-only resources.</p>
        </div>
        <div class="account-callout__actions">
          <%= link_to 'Complete signup',
                      newflow_signup_path,
                      class: 'account-callout__button account-callout__button--primary' %>
        </div>
      </div>
    <% elsif !staff && current_user.profile_needs_enrichment? %>
      <%# Non-blocking nudge for educators who used "Save and finish later" on
          step 4 and skipped optional teaching details (books, student count,
          school). Distinct from the callouts above: this user already has
          instructor access -- we're just inviting them to finish enriching
          their profile so we can point them to the right resources. %>
      <div class="account-callout" id="enrich-profile-callout">
        <div class="account-callout__text">
          <p class="account-callout__eyebrow">A couple more details</p>
          <h2 class="account-callout__title">Finish telling us about your teaching</h2>
          <p>You skipped a few questions when you signed up -- add them so we can point you to the right book resources.</p>
        </div>
        <div class="account-callout__actions">
          <%= link_to 'Finish your profile',
                      educator_profile_form_path,
                      class: 'account-callout__button account-callout__button--primary' %>
        </div>
      </div>
    <% end %>

    <% if flash[:lms_answered_label] %>
      <div id="lms-question-card" class="account-callout account-callout--lms-confirmed">
        <p><strong>Thanks!</strong> We'll surface the <%= flash[:lms_answered_label] %> setup guide under LMS / Assignable setup below.</p>
      </div>
    <% elsif @show_lms_card %>
      <div id="lms-question-card" class="account-callout account-callout--lms">
        <div class="account-callout__lms-header">
          <div class="account-callout__text">
            <p class="account-callout__eyebrow">One quick question</p>
            <h2 class="account-callout__title">Do you use a learning management system (LMS)?</h2>
            <p>We'll point you to the right Assignable setup guide.</p>
          </div>
          <%= button_to 'Not now', account_lms_answer_dismiss_path,
                        method: :post,
                        class: 'account-callout__lms-dismiss',
                        form_class: 'account-callout__lms-dismiss-form' %>
        </div>
        <div class="account-callout__lms-pills">
          <% User::LMS_OPTIONS.each do |value, label| %>
            <%= button_to label, account_lms_answer_path,
                          method: :post,
                          params: { lms_used: value },
                          class: 'account-callout__lms-pill',
                          form_class: 'account-callout__lms-pill-form' %>
          <% end %>
        </div>
      </div>
    <% end %>

    <%= render('shared/account_layout_shell') do %>
      <div class="account-shell__body account-overview">
        <section class="account-overview__section" aria-labelledby="account-details-heading">
          <div class="account-shell__section-header">
            <h2 id="account-details-heading">Account details</h2>
          </div>
          <dl class="account-facts">
            <div class="account-facts__item">
              <dt>Role</dt>
              <dd><%= role_label %></dd>
            </div>
            <div class="account-facts__item">
              <dt>School</dt>
              <dd><%= school_name.presence || 'Add your school' %></dd>
            </div>
            <% unless staff %>
              <div class="account-facts__item">
                <dt>Instructor status</dt>
                <dd><%= instructor_status %></dd>
              </div>
            <% end %>
            <div class="account-facts__item">
              <dt>Account health</dt>
              <dd><%= account_health %></dd>
            </div>
          </dl>
          <p class="account-overview__note">
            Need changes? Manage details in
            <a href="<%= account_profile_path %>">Profile</a> and <a href="<%= account_security_path %>">Security</a>.
          </p>
        </section>

        <section class="account-completeness account-overview__section" aria-label="Profile completeness">
          <div class="account-completeness__header">
            <div class="account-completeness__title">Your profile is <%= completeness[:percent] %>% complete</div>
            <div class="account-completeness__hint">
              <% remaining = completeness[:total_count] - completeness[:done_count] %>
              <%= remaining.zero? ? 'All set' : pluralize(remaining, 'item') + ' left' %>
            </div>
          </div>
          <div class="account-completeness__bar">
            <div class="account-completeness__bar-fill" style="width: <%= completeness[:percent] %>%;"></div>
          </div>
          <div class="account-completeness__chips">
            <% completeness[:items].each do |item| %>
              <% if item[:done] %>
                <span class="account-completeness__chip account-completeness__chip--done">
                  <span aria-hidden="true">&check;</span> <%= item[:label] %>
                </span>
              <% else %>
                <%= link_to account_completeness_chip_href(item[:key]), class: 'account-completeness__chip account-completeness__chip--todo' do %>
                  + <%= item[:label] %>
                <% end %>
              <% end %>
            <% end %>
          </div>
        </section>

        <section class="account-overview__section" aria-labelledby="quick-actions-heading">
          <div class="account-shell__section-header">
            <h2 id="quick-actions-heading">Quick actions</h2>
            <p>Jump straight to the tools you use most often.</p>
          </div>

          <% quick_actions = [
               { icon: 'fa fa-pencil', title: t('overview_impact.quick_action_title'), body: t('overview_impact.quick_action_body'), button: true, cta: t('overview_impact.quick_action_cta') },
               { icon: 'fa fa-plug', title: 'LMS / Assignable setup', body: 'Connect Assignable tools to Canvas, Blackboard, and more.', href: 'https://openstax.org/assignable/setup', cta: 'View setup guide →', external: true },
               { icon: 'fa fa-book', title: 'Find a book', body: 'Browse OpenStax textbooks and matching instructor resources.', href: 'https://openstax.org/subjects', cta: 'Browse subjects →', external: true },
               { icon: 'fa fa-life-ring', title: 'Get help', body: 'Search FAQs, file a ticket, or email our support team.', href: account_support_path, cta: 'Go to support →' },
               { icon: 'fa fa-envelope', title: 'Keep in touch', body: 'Get OpenStax updates about new books, webinars, and instructor opportunities.', href: 'https://openstax.org/newsletters', cta: 'Subscribe →', external: true }
             ] %>

          <ul class="account-actions">
            <% quick_actions.each do |action| %>
              <li class="account-actions__item">
                <span class="account-actions__icon <%= action[:icon] %>" aria-hidden="true"></span>
                <div class="account-actions__text">
                  <h3><%= action[:title] %></h3>
                  <p><%= action[:body] %></p>
                </div>
                <% if action[:button] %>
                  <button type="button"
                          class="account-actions__cta"
                          data-report-adoption-trigger="true">
                    <%= action[:cta] %>
                  </button>
                <% else %>
                  <a class="account-actions__cta"
                     href="<%= action[:href] %>"
                     <%= action[:external] ? 'target="_blank" rel="noopener"' : '' %>>
                    <%= action[:cta] %>
                  </a>
                <% end %>
              </li>
            <% end %>
          </ul>
        </section>

        <section class="account-overview__section" aria-labelledby="status-heading">
          <div class="account-shell__section-header">
            <h2 id="status-heading">OpenStax status</h2>
            <p>Current health of OpenStax services.</p>
          </div>
          <%# no live status check here — link out rather than assert a state %>
          <a class="account-overview__status-link"
             href="https://status.openstax.org"
             target="_blank"
             rel="noopener">
            Check current service status <span class="account-overview__external-icon" aria-hidden="true">→</span>
          </a>
        </section>
      </div>
    <% end %>
  </div>
</div>

<% if show_assignable_callout %>
  <% content_for :javascript do %>
    <script>
      document.addEventListener('click', function(event) {
        var dismissButton = event.target.closest('.js-dismiss-callout');
        if (!dismissButton) { return; }
        var targetId = dismissButton.getAttribute('data-dismiss-target');
        var target = document.getElementById(targetId);
        if (target) { target.remove(); }
        var persist = dismissButton.getAttribute('data-persist-dismissal') === 'true';
        if (persist) {
          var expiry = new Date();
          expiry.setFullYear(expiry.getFullYear() + 1);
          document.cookie = "dismissed_assignable_callout=true;path=/;expires=" + expiry.toUTCString();
        }
      });
    </script>
  <% end %>
<% end %>
