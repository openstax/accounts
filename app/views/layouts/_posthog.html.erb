<%#
  PostHog is initialized by the Google Tag Manager container wherever GTM is rendered.
  Initializing it here as well would shadow that: posthog-js keeps whichever init runs
  first, and this inline script always beats GTM's asynchronously loaded container — so a
  duplicate init here silently overrides GTM's config (including its reverse-proxied
  api_host) rather than being ignored.

  Layouts that render layouts/google_tag_manager pass `gtm: true` so we stand down.
  The admin layout has no GTM, and GTM itself only renders in production, so we keep a
  fallback init for those cases.
%>
<% unless local_assigns.fetch(:gtm, false) && google_tag_manager_enabled? %>
<script type="application/javascript">
    !function(t,e){var o,n,p,r;e.__SV||(window.posthog=e,e._i=[],e.init=function(i,s,a){function g(t,e){var o=e.split(".");2==o.length&&(t=t[o[0]],e=o[1]),t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}}(p=t.createElement("script")).type="text/javascript",p.crossOrigin="anonymous",p.async=!0,p.src=s.api_host.replace(".i.posthog.com","-assets.i.posthog.com")+"/static/array.js",(r=t.getElementsByTagName("script")[0]).parentNode.insertBefore(p,r);var u=e;for(void 0!==a?u=e[a]=[]:a="posthog",u.people=u.people||[],u.toString=function(t){var e="posthog";return"posthog"!==a&&(e+="."+a),t||(e+=" (stub)"),e},u.people.toString=function(){return u.toString(1)+".people (stub)"},o="init capture register register_once register_for_session unregister unregister_for_session getFeatureFlag getFeatureFlagPayload isFeatureEnabled reloadFeatureFlags updateEarlyAccessFeatureEnrollment getEarlyAccessFeatures on onFeatureFlags onSessionId getSurveys getActiveMatchingSurveys renderSurvey canRenderSurvey getNextSurveyStep identify setPersonProperties group resetGroups setPersonPropertiesForFlags resetPersonPropertiesForFlags setGroupPropertiesForFlags resetGroupPropertiesForFlags reset get_distinct_id getGroups get_session_id get_session_replay_url alias set_config startSessionRecording stopSessionRecording sessionRecordingStarted captureException loadToolbar get_property getSessionProperty createPersonProfile opt_in_capturing opt_out_capturing has_opted_in_capturing has_opted_out_capturing clear_opt_in_out_capturing debug getPageViewId".split(" "),n=0;n<o.length;n++)g(u,o[n]);e._i.push([i,s,a])},e.__SV=1)}(document,window.posthog||[]);
    posthog.init('<%= Rails.application.secrets.posthog_project_api_key %>', {
        api_host: 'https://z.openstax.org',
        ui_host: 'https://us.posthog.com',
        defaults: '2026-05-30',
        person_profiles: 'identified_only',
        session_recording: {
            maskAllInputs: true
        }
    })
    <% if session.delete(:posthog_reset) %>
      posthog.reset();
    <% end %>
</script>
<% end %>

<% unless current_user.is_anonymous? %>
<script type="application/javascript">
    (function () {
        function identifyCurrentUser() {
            posthog.identify(
                '<%= current_user&.uuid %>',
                {
                    email: "<%= j(current_user&.best_email_address_for_salesforce) %>",
                    name: "<%= j(current_user&.full_name) %>",
                    faculty_status: "<%= j(current_user&.faculty_status) %>",
                    role: "<%= j(current_user&.role) %>",
                    recent_authentication_provider: "<%= j(current_user&.authentications&.last&.provider) %>",
                    authentication_method_count: "<%= j(current_user&.authentications&.count) %>",
                    salesforce_school_id: "<%= j(current_user&.school&.salesforce_id) %>",
                    salesforce_contact_id: "<%= j(current_user&.salesforce_contact_id) %>",
                    salesforce_lead_id: "<%= j(current_user&.salesforce_lead_id) %>",
                    adopter_status: "<%= j(current_user&.adopter_status) %>",
                    using_openstax_how: "<%= j(current_user&.using_openstax_how) %>",
                    account_state: "<%= j(current_user&.state) %>",
                    school_type: "<%= j(current_user&.school_type) %>",
                    school_location: "<%= j(current_user&.school_location) %>",
                    is_profile_complete: <%= current_user&.is_profile_complete || false %>,
                    is_sheerid_verified: <%= current_user&.is_sheerid_verified || false %>,
                    which_books: "<%= j(current_user&.which_books) %>",
                    how_many_students: "<%= j(current_user&.how_many_students) %>",
                    title_1_school: <%= current_user&.title_1_school || false %>,
                    country_code: "<%= j(current_user&.country_code) %>",
                    is_administrator: <%= current_user&.is_administrator || false %>,
                    has_external_id: <%= current_user&.has_external_id? || false %>,
                },
                {
                    uuid: "<%= current_user&.uuid %>",
                    created_at: "<%= current_user&.created_at&.iso8601 %>",
                    activated_at: "<%= current_user&.activated_at&.iso8601 %>",
                    signup_flow: "<%= current_user&.is_newflow ? 'newflow' : 'legacy' %>"
                }
            );

            <% if current_user&.school %>
            posthog.group('school', "<%= current_user&.school&.id %>", {
                name: "<%= j(current_user&.school&.name || '') %>",
                salesforce_id: "<%= current_user&.school&.salesforce_id %>",
                city: "<%= j(current_user&.school&.city || '') %>",
                state: "<%= j(current_user&.school&.state || '') %>",
                country: "<%= j(current_user&.school&.country || '') %>",
                type: "<%= j(current_user&.school&.type || '') %>",
                location: "<%= current_user&.school&.location %>",
                has_assignable_contacts: <%= current_user&.school&.has_assignable_contacts || false %>,
            });
            <% end %>
        }

        // Where GTM owns the init, window.posthog may not exist yet — the container loads
        // asynchronously, so this script can run first. Wait for the snippet stub to
        // appear; it queues calls made before the library itself finishes loading.
        function posthogReady() {
            return window.posthog && typeof window.posthog.identify === 'function';
        }

        if (posthogReady()) {
            identifyCurrentUser();
        } else {
            var attempts = 0;
            var poll = setInterval(function () {
                if (posthogReady()) {
                    clearInterval(poll);
                    identifyCurrentUser();
                } else if (++attempts >= 100) { // give up after ~10s
                    clearInterval(poll);
                }
            }, 100);
        }
    })();
</script>
<% end %>
