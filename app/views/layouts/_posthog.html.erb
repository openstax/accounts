<%#
  PostHog is initialized exclusively by the Google Tag Manager container -- GTM is the
  single place to change client config (reverse-proxied api_host, defaults, replay
  masking). posthog-js keeps whichever init runs first, so an init here would silently
  shadow GTM's. Where GTM is absent (admin layout, any non-production environment)
  PostHog never loads and no web events are sent; server-side events via OXPosthog
  still flow.

  This partial only syncs identity state, which needs server-rendered data:
  - reset() after logout, so the next visitor isn't tracked as the previous user
  - a bare identify() once per login; person properties are set server-side by
    OXPosthog.log ($set on every captured event), the single source of truth
  - the school group association (no properties -- OXPosthog.identify_school owns those)
%>
<% posthog_reset = session.delete(:posthog_reset) %>
<% if google_tag_manager_enabled? && (posthog_reset || !current_user.is_anonymous?) %>
<script type="application/javascript">
    (function () {
        function syncPosthogIdentity() {
            <% if posthog_reset %>
            posthog.reset();
            <% end %>
            <% unless current_user.is_anonymous? %>
            if (posthog.get_distinct_id() !== '<%= current_user.uuid %>') {
                posthog.identify('<%= current_user.uuid %>');
            }
            <% if current_user.school %>
            posthog.group('school', '<%= current_user.school.id %>');
            <% end %>
            <% end %>
        }

        // GTM loads asynchronously, and the pre-load snippet stub can't answer
        // get_distinct_id(), so wait for the real library.
        function posthogReady() {
            return window.posthog && window.posthog.__loaded;
        }

        if (posthogReady()) {
            syncPosthogIdentity();
        } else {
            var attempts = 0;
            var poll = setInterval(function () {
                if (posthogReady()) {
                    clearInterval(poll);
                    syncPosthogIdentity();
                } else if (++attempts >= 100) { // give up after ~10s
                    clearInterval(poll);
                }
            }, 100);
        }
    })();
</script>
<% end %>
